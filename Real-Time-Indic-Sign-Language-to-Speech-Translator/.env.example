GROQ_API_KEY=your_groq_api_key_here

# Optional local AI sentence builder (Ollama; no cloud API key required).
ISL_OLLAMA_BASE_URL=http://127.0.0.1:11434
ISL_OLLAMA_MODEL=qwen2.5:3b
ISL_OLLAMA_TIMEOUT_SECONDS=45

# Optional paths for locally authorized model dependencies outside the repo.
# Blank values use the project-default paths.
ISL_KERAS_MODEL_PATH=
ISL_HOLISTIC_MODEL_PATH=
